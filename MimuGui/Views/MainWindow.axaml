<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MimuGui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:LocalMimu.Models"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
        x:Class="MimuGui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="LocalMimu">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
        to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Panel>

        <StackPanel IsVisible="{Binding IsLoginVisible}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18">
            <TextBlock Text="Авторизация в LocalMimu" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="20"/>
            <TextBox Width="300" Text="{Binding Username, Mode=TwoWay}" Watermark="Введите username"/>
            <TextBox Width="300" Text="{Binding Password, Mode=TwoWay}" Watermark="Введите пароль" PasswordChar="*"/>
            <Button
                Command="{Binding OnLogClicked}" BorderBrush="#3B3B3B" BorderThickness="1" Width="150" Height="35" Background="Black" HorizontalAlignment="Center" Content="Войти" HorizontalContentAlignment="Center" CornerRadius="8">
            </Button>
            <Button
                BorderBrush="#3B3B3B" BorderThickness="1" Width="150" Height="35" Background="Black" HorizontalAlignment="Center" Content="Регистрация" HorizontalContentAlignment="Center" CornerRadius="8">
            </Button>

            <TextBlock Text="{Binding StatusMessage}" Foreground="#810505" HorizontalAlignment="Center" FontSize="14">
            </TextBlock>
        </StackPanel>
        <Grid IsVisible="{Binding !IsLoginVisible}" ColumnDefinitions="250,*">

            <!--Списки чатов (Колонка 0)-->
            <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#202020" BorderThickness="0,0,1,0">
                <StackPanel Margin="15" Spacing="10">
                    <TextBlock Text="Чаты" FontSize="18" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>


                    <!-- Заменили ItemsControl на ListBox и привязали выбранного юзера -->
                    <ListBox ItemsSource="{Binding ActiveChats}"
                             SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0">

                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:User">
                                <Border Width="200" Height="50" Background="Transparent" Padding="5">
                                    <StackPanel Orientation="Horizontal" Spacing="15">
                                        <Border Width="30" Height="30" Background="#424141" CornerRadius="15" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Username}" VerticalAlignment="Center" Foreground="White" FontWeight="Medium"/>
                                    </StackPanel>
                            </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Width="220" Height="60" Background="#2C2C2C" CornerRadius="8" Padding="10">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <Border Width="40" Height="40" Background="#504F4F" CornerRadius="20" VerticalAlignment="Center"/>
                            <TextBlock VerticalAlignment="Center" Foreground="White" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
<Border Grid.Column="1" Background="#121212">
    <Grid RowDefinitions="40,*,60">

        <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#202020" BorderThickness="0,0,0,1" Padding="10,0">
            <TextBlock Text="{Binding StatusMessage}" 
                       Foreground="White" 
                       FontSize="14" 
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </Border>

        <ListBox Grid.Row="1" 
                 ItemsSource="{Binding ChatMessages}" 
                 Background="Transparent" 
                 BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel VerticalAlignment="Bottom" Spacing="8" Margin="10"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate DataType="models:Message">
                    <Border CornerRadius="10" 
                            Padding="12,8" 
                            MaxWidth="400"
                            Background="#202020"
                            BorderBrush="#2C2C2C"
                            BorderThickness="1"
                            HorizontalAlignment="Left">
                        
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Text}" 
                                       Foreground="White" 
                                       FontSize="15" 
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SentAt, StringFormat=\{0:HH:mm\}}" 
                                       Foreground="Gray" 
                                       FontSize="11" 
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <Border Grid.Row="2" Background="#1E1E1E" BorderBrush="#202020" BorderThickness="0,1,0,0" Padding="10">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding NewMessageText, Mode=TwoWay}" Grid.Column="0" Watermark="Написать сообщение..." VerticalAlignment="Center"/>
                <Button Command="{Binding OnSendClicked}" Grid.Column="1" Content="Отправить" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalContentAlignment="Center"/>
            </Grid>
        </Border>
        
    </Grid>
</Border>

        </Grid>


    </Panel>

</Window>
